# The osxcross image documented in docs/macos-cross-build.md, with both Apple
# targets installed for the toolchain packaging/build-all.sh selects. Without
# them cargo reports "can't find crate for core".
FROM rust-darwin-builder:1.95

RUN rustup target add --toolchain 1.95.0 x86_64-apple-darwin aarch64-apple-darwin

# The media engine of the voice-chat sink is fetched as an archive, so the build
# needs curl and unzip next to the toolchain.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*
