# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Nix development shell
/.direnv
/.cargo/config.toml

# Secrets: API keys are referenced through environment variables, never committed
.env
.env.*
!.env.example

# Audio artifacts produced by local runs and tests
/*.wav
/*.pcm
/*.raw

# Transcripts and captions produced by local runs
/*.srt
/*.vtt
/*.jsonl
/transcript.*

# Release packaging: working directories and outputs of packaging/build-*.sh
/dist
/build
*.deb
*.rpm
*.AppImage
*.dmg
*.msi
# ...but the disk image builder is a Dockerfile, not an artefact
!packaging/Dockerfile.dmg

# Editor and OS files
/.idea
/.vscode
*.swp
*~
.DS_Store

# Agent working directories
/.junie
/.agents
/.codex
